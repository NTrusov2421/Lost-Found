@startuml
|Backend / Планировщик|
start
switch (Событие?)
case (Cron)
  :Автоочистка: удаление просроченных items и файлов;
case (Запрос пользователя)
  |Пользователь|
  :Действие (Поиск, Создание, Жалоба, Профиль);
  |Backend / Планировщик|
  :Валидация и RBAC;
  switch (Сценарий?)
  case (Поиск / Просмотр)
    :Запрос к БД, вывод каталога;
  case (Создание / Редактирование)
    :Сохранение файла и items (гость +7 дней);
    :Email-уведомление автору;
  case (Жалоба)
    :Сохранение в БД complaints;
    :Email администратору;
  case (Профиль / Вход)
    :Проверка токена, обновление users;
  endswitch
case (Модерация администратором)
  |Администратор|
  :Просмотр очереди жалоб, юзеров, items;
  |Backend / Планировщик|
  :Сохранение статуса модерации в БД;
  :Email-уведомление пользователю;
endswitch
stop
@enduml